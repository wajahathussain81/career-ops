# Required: the server refuses to start until this placeholder is changed.
HUB_TOKEN=change-me
# Bind locally; use 0.0.0.0 only when the hub is behind a reverse proxy.
# HUB_HOST=127.0.0.1
HUB_PORT=8484
HUB_ROOT=/opt/career-ops
# Set when serving the hub over HTTPS/TLS.
# HUB_COOKIE_SECURE=1
# Align the daily quota boundary and status-log timestamps to local time.
# CAREER_OPS_TZ=America/Edmonton
